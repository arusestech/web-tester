{
  "extends": "_공통.json",
  "name": "SIT-VOC-0002-06 VOC마스터_모니터링",
  "_comment": "SIT v0.6 SIT-VOC-0002-06 — 흐름 이름의 S<n> 이 문서 스텝 번호",
  "login": {
    "url": "/screen/BCO0001.ub",
    "userField": "#userid",
    "logoutUrl": "/logout.ub",
    "retries": 1,
    "_comment_retries": "비밀번호 연속 실패 시 계정 잠금(maxFailPassword) → 재시도 1회",
    "steps": [
      {
        "action": "fill",
        "selector": "#userid",
        "value": "{{id_master}}"
      },
      {
        "action": "fill",
        "selector": "#userpw",
        "value": "{{password}}"
      },
      {
        "action": "click",
        "selector": "#login"
      },
      {
        "action": "waitForLoad",
        "state": "networkidle"
      }
    ],
    "success": {
      "urlContains": "POR0001",
      "selector": "#menu"
    }
  },
  "_manual_steps": [
    "S3 종결 건 직권 수정 저장 — 0001-11 S5 와 같은 흐름"
  ],
  "menus": [],
  "crud": [
    {
      "name": "S1 진행상태별 조회",
      "steps": [
        {
          "action": "goto",
          "url": "/screen/VOC0019.ub"
        },
        {
          "action": "waitForLoad",
          "state": "networkidle"
        },
        {
          "action": "wait",
          "ms": 1500
        },
        {
          "action": "eval",
          "script": "(()=>{const e=document.querySelector(\"#CD_VOC_STATUS\");if(!e)throw new Error('콤보 없음: '+\"#CD_VOC_STATUS\");const p=\"\";let o=null;if(p)o=[...e.options].find(x=>x.value===p||x.text.includes(p));if(!o)o=[...e.options].find(x=>x.value!==''&&!/선택|전체/.test(x.text));if(!o)throw new Error('선택할 옵션 없음: '+\"#CD_VOC_STATUS\"+' ['+[...e.options].map(x=>x.value+':'+x.text).join(',')+']');e.value=o.value;e.dispatchEvent(new Event('change',{bubbles:true}));})()"
        },
        {
          "action": "click",
          "selector": "#searchBtn"
        },
        {
          "action": "waitForLoad",
          "state": "networkidle"
        },
        {
          "action": "wait",
          "ms": 2500
        },
        {
          "action": "expectVisible",
          "selector": "#gbox_list"
        },
        {
          "action": "screenshot",
          "name": "상태별"
        }
      ]
    },
    {
      "name": "S2 상세 이동",
      "steps": [
        {
          "action": "switchUser",
          "user": "{{id_master}}"
        },
        {
          "action": "wait",
          "ms": 1000
        },
        {
          "action": "goto",
          "url": "/screen/VOC0019.ub"
        },
        {
          "action": "waitForLoad",
          "state": "networkidle"
        },
        {
          "action": "wait",
          "ms": 1500
        },
        {
          "action": "eval",
          "script": "(()=>{const l=document.querySelector('.ub-layout.search-advanced');if(l&&l.classList.contains('close')){const b=l.querySelector('span.btn a')||l.querySelector('span.btn');if(b)b.click();}})()"
        },
        {
          "action": "wait",
          "ms": 800
        },
        {
          "action": "eval",
          "script": "(()=>{let b=document.querySelector('#__wwt_var');if(!b){b=document.createElement('input');b.id='__wwt_var';b.style.cssText='position:fixed;left:0;top:0;width:160px;height:22px;z-index:2147483647;opacity:1';document.body.appendChild(b);}b.value='';})()"
        },
        {
          "action": "fill",
          "selector": "#__wwt_var",
          "value": "{{mark}} 기본흐름"
        },
        {
          "action": "eval",
          "script": "(()=>{const v=(()=>{const b=document.querySelector('#__wwt_var');const v=b?b.value:'';if(b)b.remove();return v;})();const e=document.querySelector(\"#DS_TITLE\");if(!e)throw new Error('입력칸 없음: '+\"#DS_TITLE\");e.readOnly=false;e.disabled=false;e.value=v;e.dispatchEvent(new Event('input',{bubbles:true}));e.dispatchEvent(new Event('change',{bubbles:true}));})()"
        },
        {
          "action": "click",
          "selector": "#searchBtn"
        },
        {
          "action": "waitForLoad",
          "state": "networkidle"
        },
        {
          "action": "wait",
          "ms": 3000
        },
        {
          "action": "expectText",
          "text": "{{mark}} 기본흐름"
        },
        {
          "action": "eval",
          "script": "(()=>{let b=document.querySelector('#__wwt_var');if(!b){b=document.createElement('input');b.id='__wwt_var';b.style.cssText='position:fixed;left:0;top:0;width:160px;height:22px;z-index:2147483647;opacity:1';document.body.appendChild(b);}b.value='';})()"
        },
        {
          "action": "fill",
          "selector": "#__wwt_var",
          "value": "{{mark}} 기본흐름"
        },
        {
          "action": "eval",
          "script": "(()=>{const t=(()=>{const b=document.querySelector('#__wwt_var');const v=b?b.value:'';if(b)b.remove();return v;})();const r=[...document.querySelectorAll(\"#list tr.jqgrow\")].find(r=>r.innerText.includes(t));if(!r)throw new Error('목록에 행 없음: '+t);const td=[...r.querySelectorAll('td')].find(x=>x.innerText.includes(t))||r.querySelectorAll('td')[1];td.click();})()"
        },
        {
          "action": "waitForLoad",
          "state": "networkidle"
        },
        {
          "action": "wait",
          "ms": 2500
        },
        {
          "action": "expectUrl",
          "contains": "VOC0004"
        },
        {
          "action": "screenshot",
          "name": "상세"
        }
      ]
    },
