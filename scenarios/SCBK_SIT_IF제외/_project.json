{
  "_comment": "SCBK VOC SIT(폐쇄망). baseUrl 은 반입 후 🔧 프로젝트 설정에서 SIT 접속 주소로 바꾼다(컨텍스트 없음, 로그인 화면 = <주소>/screen/BCO0001.ub). 브라우저 채널은 비워 두면 Chrome → Edge 순으로 자동 선택 — 인터페이스 제외본(22건)",
  "baseUrl": "https://voc-sit.change-me.invalid",
  "browser": {
    "headless": false,
    "viewport": {
      "width": 1600,
      "height": 1000
    }
  },
  "reuseSession": false,
  "login": {
    "url": "/screen/BCO0001.ub",
    "userField": "#userid",
    "logoutUrl": "/logout.ub",
    "retries": 1,
    "_comment_retries": "비밀번호 연속 실패 시 계정 잠금(maxFailPassword) → 재시도 1회",
    "steps": [
      {
        "action": "fill",
        "selector": "#userid",
        "value": "{{id_admin}}"
      },
      {
        "action": "fill",
        "selector": "#userpw",
        "value": "{{password}}"
      },
      {
        "action": "click",
        "selector": "#login"
      },
      {
        "action": "waitForLoad",
        "state": "networkidle"
      }
    ],
    "success": {
      "urlContains": "POR0001",
      "selector": "#menu"
    }
  }
}
