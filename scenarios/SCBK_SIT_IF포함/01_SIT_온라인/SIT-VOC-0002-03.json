{
  "extends": "_공통.json",
  "name": "SIT-VOC-0002-03 부서VOC조회",
  "_comment": "SIT v0.6 SIT-VOC-0002-03 — 흐름 이름의 S<n> 이 문서 스텝 번호",
  "login": {
    "url": "/screen/BCO0001.ub",
    "userField": "#userid",
    "logoutUrl": "/logout.ub",
    "retries": 1,
    "_comment_retries": "비밀번호 연속 실패 시 계정 잠금(maxFailPassword) → 재시도 1회",
    "steps": [
      {
        "action": "fill",
        "selector": "#userid",
        "value": "{{id_dept}}"
      },
      {
        "action": "fill",
        "selector": "#userpw",
        "value": "{{password}}"
      },
      {
        "action": "click",
        "selector": "#login"
      },
      {
        "action": "waitForLoad",
        "state": "networkidle"
      }
    ],
    "success": {
      "urlContains": "POR0001",
      "selector": "#menu"
    }
  },
  "menus": [
    {
      "name": "부서VOC조회",
      "url": "/screen/VOC0021.ub",
      "expect": [
        "#gbox_list"
      ]
    }
  ],
  "crud": [
    {
      "name": "S1 화면 표시",
      "steps": [
        {
          "action": "switchUser",
          "user": "{{id_dept}}"
        },
        {
          "action": "wait",
          "ms": 1000
        },
        {
          "action": "goto",
          "url": "/screen/VOC0021.ub"
        },
        {
          "action": "waitForLoad",
          "state": "networkidle"
        },
        {
          "action": "wait",
          "ms": 1500
        },
        {
          "action": "expectVisible",
          "selector": "#searchBtn"
        },
        {
          "action": "expectVisible",
          "selector": "#gbox_list"
        },
        {
          "action": "expectNotText",
          "text": "시스템 오류"
        },
        {
          "action": "screenshot",
          "name": "화면"
        }
      ]
    },
    {
