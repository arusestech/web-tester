{
  "extends": "_공통.json",
  "name": "SIT-VOC-0003-03 VOC월간레포트1",
  "_comment": "SIT v0.6 SIT-VOC-0003-03 — 흐름 이름의 S<n> 이 문서 스텝 번호",
  "login": {
    "url": "/screen/BCO0001.ub",
    "userField": "#userid",
    "logoutUrl": "/logout.ub",
    "retries": 1,
    "_comment_retries": "비밀번호 연속 실패 시 계정 잠금(maxFailPassword) → 재시도 1회",
    "steps": [
      {
        "action": "fill",
        "selector": "#userid",
        "value": "{{id_master}}"
      },
      {
        "action": "fill",
        "selector": "#userpw",
        "value": "{{password}}"
      },
      {
        "action": "click",
        "selector": "#login"
      },
      {
        "action": "waitForLoad",
        "state": "networkidle"
      }
    ],
    "success": {
      "urlContains": "POR0001",
      "selector": "#menu"
    }
  },
  "_manual_steps": [
    "S4 레포트 수치 ↔ 전체 VOC 조회 건수 대조(통계 배치 실행 후)",
    "S5 [레포트] 버튼은 UBIFORM 뷰어 — 사용 여부 미확정이라 자동화 제외"
  ],
  "menus": [
    {
      "name": "통계/레포트 > VOC 월간 레포트1",
      "url": "/screen/ANA3101.ub",
      "expect": [
        "#gbox_list",
        "#searchBtn"
      ]
    }
  ],
  "crud": [
    {
      "name": "S1~S3 기준년월 조회",
      "steps": [
        {
          "action": "goto",
          "url": "/screen/ANA3101.ub"
        },
        {
          "action": "waitForLoad",
          "state": "networkidle"
        },
        {
          "action": "wait",
          "ms": 1500
        },
        {
          "action": "eval",
          "script": "(()=>{const e=document.querySelector(\"#DS_YYYY\");if(!e)throw new Error('콤보 없음: '+\"#DS_YYYY\");const p=\"\";let o=null;if(p)o=[...e.options].find(x=>x.value===p||x.text.includes(p));if(!o)o=[...e.options].find(x=>x.value!==''&&!/선택|전체/.test(x.text));if(!o)throw new Error('선택할 옵션 없음: '+\"#DS_YYYY\"+' ['+[...e.options].map(x=>x.value+':'+x.text).join(',')+']');e.value=o.value;e.dispatchEvent(new Event('change',{bubbles:true}));})()"
        },
        {
          "action": "click",
          "selector": "#searchBtn"
        },
        {
          "action": "waitForLoad",
          "state": "networkidle"
        },
        {
          "action": "wait",
          "ms": 5000
        },
        {
          "action": "expectVisible",
          "selector": "#gbox_list"
        },
        {
          "action": "expectNotText",
          "text": "시스템 오류"
        },
        {
          "action": "screenshot",
          "name": "월간레포트"
        }
      ]
    }
  ]
}
