    {
      "name": "S1 화면 표시",
      "steps": [
        {
          "action": "switchUser",
          "user": "{{id_crt}}"
        },
        {
          "action": "wait",
          "ms": 1000
        },
        {
          "action": "goto",
          "url": "/screen/VOC0003.ub"
