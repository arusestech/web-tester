{
  "extends": "_공통.json",
  "name": "SIT-VOC-0002-01 등록VOC_조회",
  "_comment": "SIT v0.6 SIT-VOC-0002-01 — 흐름 이름의 S<n> 이 문서 스텝 번호",
  "login": {
    "url": "/screen/BCO0001.ub",
    "userField": "#userid",
    "logoutUrl": "/logout.ub",
    "retries": 1,
    "_comment_retries": "비밀번호 연속 실패 시 계정 잠금(maxFailPassword) → 재시도 1회",
    "steps": [
      {
        "action": "fill",
        "selector": "#userid",
        "value": "{{id_crt}}"
      },
      {
        "action": "fill",
        "selector": "#userpw",
        "value": "{{password}}"
      },
      {
        "action": "click",
        "selector": "#login"
      },
      {
        "action": "waitForLoad",
        "state": "networkidle"
      }
    ],
    "success": {
      "urlContains": "POR0001",
      "selector": "#menu"
    }
  },
  "menus": [
    {
      "name": "등록VOC_조회",
      "url": "/screen/VOC0003.ub",
      "expect": [
        "#gbox_list"
      ]
    }
  ],
