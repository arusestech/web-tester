{
  "extends": "_공통.json",
  "name": "SIT-VOC-0002-07 받은통보_통보이력",
  "_comment": "SIT v0.6 SIT-VOC-0002-07 — 흐름 이름의 S<n> 이 문서 스텝 번호",
  "login": {
    "url": "/screen/BCO0001.ub",
    "userField": "#userid",
    "logoutUrl": "/logout.ub",
    "retries": 1,
    "_comment_retries": "비밀번호 연속 실패 시 계정 잠금(maxFailPassword) → 재시도 1회",
    "steps": [
      {
        "action": "fill",
        "selector": "#userid",
        "value": "{{id_master}}"
      },
      {
        "action": "fill",
        "selector": "#userpw",
        "value": "{{password}}"
      },
      {
        "action": "click",
        "selector": "#login"
      },
      {
        "action": "waitForLoad",
        "state": "networkidle"
      }
    ],
    "success": {
      "urlContains": "POR0001",
      "selector": "#menu"
    }
  },
  "_manual_steps": [
    "재발송 버튼은 forbidden — 누르지 않음"
  ],
  "menus": [],
  "crud": [
    {
      "name": "S1 통보이력 탭",
      "steps": [
        {
          "action": "switchUser",
          "user": "{{id_master}}"
        },
        {
          "action": "wait",
          "ms": 1000
        },
        {
          "action": "goto",
          "url": "/screen/VOC0019.ub"
        },
        {
          "action": "waitForLoad",
          "state": "networkidle"
        },
        {
          "action": "wait",
          "ms": 1500
        },
        {
          "action": "eval",
          "script": "(()=>{const l=document.querySelector('.ub-layout.search-advanced');if(l&&l.classList.contains('close')){const b=l.querySelector('span.btn a')||l.querySelector('span.btn');if(b)b.click();}})()"
        },
        {
          "action": "wait",
          "ms": 800
        },
        {
          "action": "eval",
          "script": "(()=>{let b=document.querySelector('#__wwt_var');if(!b){b=document.createElement('input');b.id='__wwt_var';b.style.cssText='position:fixed;left:0;top:0;width:160px;height:22px;z-index:2147483647;opacity:1';document.body.appendChild(b);}b.value='';})()"
        },
        {
          "action": "fill",
          "selector": "#__wwt_var",
          "value": "{{mark}} 기본흐름"
        },
        {
          "action": "eval",
          "script": "(()=>{const v=(()=>{const b=document.querySelector('#__wwt_var');const v=b?b.value:'';if(b)b.remove();return v;})();const e=document.querySelector(\"#DS_TITLE\");if(!e)throw new Error('입력칸 없음: '+\"#DS_TITLE\");e.readOnly=false;e.disabled=false;e.value=v;e.dispatchEvent(new Event('input',{bubbles:true}));e.dispatchEvent(new Event('change',{bubbles:true}));})()"
        },
        {
          "action": "click",
          "selector": "#searchBtn"
        },
        {
          "action": "waitForLoad",
          "state": "networkidle"
        },
        {
          "action": "wait",
          "ms": 3000
        },
        {
          "action": "expectText",
          "text": "{{mark}} 기본흐름"
        },
        {
          "action": "eval",
          "script": "(()=>{let b=document.querySelector('#__wwt_var');if(!b){b=document.createElement('input');b.id='__wwt_var';b.style.cssText='position:fixed;left:0;top:0;width:160px;height:22px;z-index:2147483647;opacity:1';document.body.appendChild(b);}b.value='';})()"
        },
        {
          "action": "fill",
          "selector": "#__wwt_var",
          "value": "{{mark}} 기본흐름"
        },
        {
          "action": "eval",
          "script": "(()=>{const t=(()=>{const b=document.querySelector('#__wwt_var');const v=b?b.value:'';if(b)b.remove();return v;})();const r=[...document.querySelectorAll(\"#list tr.jqgrow\")].find(r=>r.innerText.includes(t));if(!r)throw new Error('목록에 행 없음: '+t);const td=[...r.querySelectorAll('td')].find(x=>x.innerText.includes(t))||r.querySelectorAll('td')[1];td.click();})()"
        },
        {
          "action": "waitForLoad",
          "state": "networkidle"
        },
        {
          "action": "wait",
          "ms": 2500
        },
        {
          "action": "click",
          "selector": "#tabs a[href=\"#tab_item_COM0002\"]"
        },
        {
          "action": "wait",
          "ms": 2000
        },
        {
          "action": "frame",
          "name": "tabFrame_tab_item_COM0002"
        },
        {
          "action": "expectVisible",
          "selector": "#gbox_list"
        },
        {
          "action": "mainFrame"
        },
        {
          "action": "screenshot",
          "name": "통보이력"
        }
      ]
    },
