{
  "extends": "_공통.json",
  "name": "SIT-VOC-0004-02 E2E_권한별메뉴노출",
  "_comment": "SIT v0.6 SIT-VOC-0004-02 — 계정별 대메뉴 노출 + 미권한 화면 URL 직접 접근 시 '접근권한이 없습니다' 확인. 기대 메뉴는 SIT DB 권한(AP_AUTH) 기준으로 첫 실행 후 보정",
  "login": {
    "url": "/screen/BCO0001.ub",
    "userField": "#userid",
    "logoutUrl": "/logout.ub",
    "retries": 1,
    "_comment_retries": "비밀번호 연속 실패 시 계정 잠금(maxFailPassword) → 재시도 1회",
    "steps": [
      {
        "action": "fill",
        "selector": "#userid",
        "value": "{{id_admin}}"
      },
      {
        "action": "fill",
        "selector": "#userpw",
        "value": "{{password}}"
      },
      {
        "action": "click",
        "selector": "#login"
      },
      {
        "action": "waitForLoad",
        "state": "networkidle"
      }
    ],
    "success": {
      "urlContains": "POR0001",
      "selector": "#menu"
    }
  },
  "_manual_steps": [
    "하위 메뉴 전체 대조는 권한별메뉴목록 엑셀과 수동 대조"
  ],
  "menus": [],
