{
  "extends": "_공통.json",
  "name": "E2E01-3 [220 VOC관리자] 답변완료·통계 확인",
  "_comment": "E2E-01 3단계. 220 이 회신 확인 후 답변완료",
  "_comment_baseUrl": "8080 = 로컬 Tomcat(SMTP 목업 localhost:1025 적용 war). 8888 = IntelliJ Tomcat(메일 host 내부망 IP → 발송 실패). CrossEditor 라이선스는 도메인 기준이라 포트 무관",
  "_comment_ignore": "/login.ub 404 = loginSuccess.jsp 가 컨텍스트 없는 /screen/POR0001.ub 로 보내는 알려진 현상(세션은 정상)",
  "login": {
    "steps": [
      {
        "action": "fill",
        "selector": "#userid",
        "value": "TEST_R220"
      },
      {
        "action": "fill",
        "selector": "#userpw",
        "value": "{{password}}"
      },
      {
        "action": "click",
        "selector": "#login"
      },
      {
        "action": "waitForLoad",
        "state": "networkidle"
      },
      {
        "action": "goto",
        "url": "/screen/POR0001.ub"
      },
      {
        "action": "waitForLoad",
        "state": "networkidle"
      }
    ]
  },
  "crud": [
    {
      "name": "VOC1401 업무요청 VOC 에서 회신 확인 → VOC1002 답변완료(P0→E0)",
      "allowForbidden": [
        "답변완료",
        "저장",
        "Save",
        "수정"
      ],
      "steps": [
        {
          "action": "goto",
          "url": "/screen/VOC1401.ub"
        },
        {
          "action": "waitForLoad",
          "state": "networkidle"
        },
        {
          "action": "click",
          "selector": "#searchBtn a, #searchBtn"
        },
        {
          "action": "waitForLoad",
          "state": "networkidle"
        },
        {
          "action": "wait",
          "ms": 1500
        },
        {
          "action": "eval",
          "script": "(()=>{const td=[...document.querySelectorAll('table.ui-jqgrid-btable td')].find(t=>t.textContent.includes('TEST_E2E01'));if(!td)throw new Error('행 없음: TEST_E2E01');td.dispatchEvent(new MouseEvent('dblclick',{bubbles:true}));})()"
        },
        {
          "action": "waitForLoad",
          "state": "networkidle"
        },
        {
          "action": "wait",
          "ms": 2500
        },
        {
          "action": "expectText",
          "text": "회신내용(자동, 고객서비스팀)"
        },
        {
          "action": "screenshot",
          "name": "회신확인"
        },
        {
          "action": "note",
          "_verified": "8/25 라이브: Call 채널 VOC 는 관리자(220) 화면에서 답변 패널이 view(label) → [답변수정](btnAnsModify) → VOC0026 팝업에서 DS_ANSWER_CN 저장. btnAnsCmpl 은 미노출"
        },
        {
          "action": "click",
          "selector": "#btnAnsModify a",
          "popup": true
        },
        {
          "action": "waitForLoad",
          "state": "networkidle"
        },
        {
          "action": "wait",
          "ms": 1200
        },
        {
          "action": "fill",
          "selector": "#DS_ANSWER_CN",
          "value": "TEST_E2E01 최종 답변(자동, 관리자)"
        },
        {
          "action": "eval",
          "script": "(()=>{const b=document.getElementById('btnSave');if(!b)throw new Error('버튼 없음: btnSave');(b.querySelector('a')||b).click();})()"
        },
        {
          "action": "expectDialog",
          "text": "저장"
        },
        {
          "action": "wait",
          "ms": 3000
        },
        {
          "action": "closePopup"
        },
        {
          "action": "wait",
          "ms": 1500
        },
        {
          "action": "expectText",
          "text": "최종 답변(자동, 관리자)"
        },
        {
          "action": "screenshot",
          "name": "답변수정완료"
        }
      ]
    },
    {
      "name": "ANA0021 처리부서 통계 반영 확인(조회)",
      "steps": [
        {
          "action": "goto",
          "url": "/screen/ANA0021.ub"
        },
        {
          "action": "waitForLoad",
          "state": "networkidle"
        },
        {
          "action": "click",
          "selector": "#searchBtn a, #searchBtn"
        },
        {
          "action": "waitForLoad",
          "state": "networkidle"
        },
        {
          "action": "wait",
          "ms": 2000
        },
        {
          "action": "screenshot",
          "name": "통계"
        }
      ]
    },
    {
      "name": "로그아웃",
      "steps": [
        {
          "action": "goto",
          "url": "/screen/POR0001.ub"
        },
        {
          "action": "click",
          "selector": ".logout-button a"
        },
        {
          "action": "expectDialog",
          "text": "로그아웃"
        },
        {
          "action": "waitForLoad",
          "state": "networkidle"
        },
        {
          "action": "expectUrl",
          "contains": "BCO0001"
        }
      ]
    }
  ]
}