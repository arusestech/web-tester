{
  "extends": "_공통.json",
  "name": "E2E05-3 [100 시스템관리자] 공지 정리",
  "_comment": "E2E-05 3단계",
  "_comment_baseUrl": "8080 = 로컬 Tomcat(SMTP 목업 localhost:1025 적용 war). 8888 = IntelliJ Tomcat(메일 host 내부망 IP → 발송 실패). CrossEditor 라이선스는 도메인 기준이라 포트 무관",
  "_comment_ignore": "/login.ub 404 = loginSuccess.jsp 가 컨텍스트 없는 /screen/POR0001.ub 로 보내는 알려진 현상(세션은 정상)",
  "login": {
    "steps": [
      {
        "action": "fill",
        "selector": "#userid",
        "value": "test01"
      },
      {
        "action": "fill",
        "selector": "#userpw",
        "value": "{{password}}"
      },
      {
        "action": "click",
        "selector": "#login"
      },
      {
        "action": "waitForLoad",
        "state": "networkidle"
      },
      {
        "action": "goto",
        "url": "/screen/POR0001.ub"
      },
      {
        "action": "waitForLoad",
        "state": "networkidle"
      }
    ]
  },
  "crud": [
    {
      "name": "INF4001 → 공지 상세 → 삭제 → 휴지통 확인",
      "allowForbidden": [
        "삭제",
        "Delete"
      ],
      "steps": [
        {
          "action": "goto",
          "url": "/screen/INF4001.ub"
        },
        {
          "action": "waitForLoad",
          "state": "networkidle"
        },
        {
          "action": "click",
          "selector": "#btnSearch a, #btnSearch"
        },
        {
          "action": "waitForLoad",
          "state": "networkidle"
        },
        {
          "action": "wait",
          "ms": 1500
        },
        {
          "action": "eval",
          "script": "(()=>{const td=[...document.querySelectorAll('table.ui-jqgrid-btable td')].find(t=>t.textContent.includes('TEST_E2E01_공지'));if(!td)throw new Error('행 없음: TEST_E2E01_공지');td.dispatchEvent(new MouseEvent('dblclick',{bubbles:true}));})()"
        },
        {
          "action": "waitForLoad",
          "state": "networkidle"
        },
        {
          "action": "wait",
          "ms": 2500
        },
        {
          "action": "screenshot",
          "name": "상세"
        },
        {
          "action": "note",
          "_manual": "INF4006(삭제) → INF4007(휴지통). 영구삭제(INF4008) 는 FG_DEL 플래그만 세우므로 물리 정리는 SQL(TBS_KNWLDG)"
        }
      ]
    },
    {
      "name": "로그아웃",
      "steps": [
        {
          "action": "goto",
          "url": "/screen/POR0001.ub"
        },
        {
          "action": "click",
          "selector": ".logout-button a"
        },
        {
          "action": "expectDialog",
          "text": "로그아웃"
        },
        {
          "action": "waitForLoad",
          "state": "networkidle"
        },
        {
          "action": "expectUrl",
          "contains": "BCO0001"
        }
      ]
    }
  ]
}